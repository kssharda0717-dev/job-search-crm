{
  "name": "@crm/extension",
  "displayName": "Job Search CRM & Networking Copilot",
  "version": "1.0.0",
  "description": "Autonomous job application tracking, tailored-resume vault, and human-in-the-loop outreach drafting.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@plasmohq/storage": "^1.13.0",
    "plasmo": "^0.89.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "manifest": {
    "name": "Job Search CRM & Networking Copilot",
    "permissions": [
      "storage",
      "unlimitedStorage",
      "tabs",
      "alarms",
      "sidePanel",
      "scripting"
    ],
    "host_permissions": [
      "https://www.linkedin.com/*",
      "http://localhost/*"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
}

# Copy to server/.env and fill in. Never commit the filled-in copy.
#   cp server/.env.example server/.env

# Port the proxy listens on. It binds to 127.0.0.1 only.
PORT=8787

# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key. Never ship this to the browser; it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string, used ONLY by `pnpm --filter @crm/server migrate`.
# This is not SUPABASE_URL: the REST API cannot create tables.
#
# Supabase dashboard -> the "Connect" button in the top bar (NOT Project
# Settings -> Database, which no longer carries it) -> Connection String ->
# the box labelled **Session pooler**. Substitute your database password for
# [YOUR-PASSWORD], brackets included. The pooler's username is
# `postgres.<project-ref>` — the dot and the ref are part of it, not a typo.
# The password is not viewable after the project is created; if you do not have
# it, Project Settings -> Database -> Reset database password. Nothing else in
# this project uses it — the server talks to Supabase over the REST API with
# SUPABASE_SERVICE_ROLE_KEY, so resetting breaks nothing here.
#
# Use the *session pooler*. Not the transaction pooler on port 6543: the runner
# holds pg_advisory_lock, which is session-scoped, and a transaction pooler
# returns the connection to the pool after every statement, so the lock would
# end up on a different backend than the one running the migration.
#
# The *direct connection* (db.<ref>.supabase.co) also works, but only from a
# host with IPv6: on newer projects that name has an AAAA record and no A
# record at all. That rules it out for Docker, whose Linux VM has no global
# IPv6 address by default — and the failure does not say "IPv6", it says
#   getaddrinfo ENOTFOUND db.<ref>.supabase.co
# because `net.connect` resolves with ADDRCONFIG, which drops AAAA results on
# a host that cannot route them, leaving zero addresses. The container can even
# see the record on a plain lookup; it is the connect path that filters it.
# Verified 2026-10-08 inside the image. The session pooler is IPv4, so it is
# the one that works everywhere and the one to prefer.
#
# The server itself never reads this, so you can leave it out of a deployed
# server's environment once the migrations have run.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

OPENAI_API_KEY=

# Shared secret between extension and proxy. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_AUTH_TOKEN=

# Comma-separated extension origins allowed to call this server.
# `chrome-extension://*` is a development convenience that accepts any
# extension. Tighten it to your built extension's id before you rely on it:
#   ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=chrome-extension://*

# Optional. Enables recent-company-news icebreakers on follow-ups.
TAVILY_API_KEY=

# Optional. Where dense vectors live: `pgvector` (default) or `qdrant`.
# Switching does not migrate an existing corpus — re-index through the Vault.
# QDRANT_URL is required when VECTOR_STORE=qdrant.
VECTOR_STORE=pgvector
QDRANT_URL=
QDRANT_API_KEY=
